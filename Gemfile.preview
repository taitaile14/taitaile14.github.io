# Local preview only. GitHub Pages builds the site from `Gemfile`.
# Jekyll 3.9 (the github-pages pin) does not run on Ruby 3.4+/4.x, so previews
# use Jekyll 4 with the same plugin set. Rendering is equivalent for this theme.
source "https://rubygems.org"
gem "jekyll", "~> 4.4"
gem "kramdown-parser-gfm"
gem "jekyll-sitemap"
gem "jekyll-feed"
gem "jekyll-paginate"
gem "jekyll-gist"
gem "jekyll-redirect-from"
gem "jemoji"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
gem "webrick"
